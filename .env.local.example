# Conexão do Neon Postgres (pegue em neon.tech ou na integração do Vercel)
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require"

# Senha que você vai usar para acessar o painel
APP_PASSWORD="troque-essa-senha"

# Segredo para assinar cookies de sessão (gere com: openssl rand -base64 32)
AUTH_SECRET="gere-uma-string-aleatoria-de-32-caracteres-ou-mais"
